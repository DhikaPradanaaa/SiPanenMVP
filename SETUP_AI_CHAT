## 3. Integrasi Data Panen ke Konteks AI

### 3.1 Ambil Data Real dari Hook

Di `src/pages/PetaniAI.tsx`, import hook data panen dan Gemini client:

```typescript
import { useDataTanam } from "@/hooks/useSupabaseData";
import { sendToGemini } from "@/lib/gemini";
```

Di dalam komponen:

```typescript
// Ambil data panen real dari database/localStorage
const { data: dataTanam } = useDataTanam();

// Jika ada data real, gunakan itu. Jika tidak, fallback ke mock data.
const lahanDisplay = dataTanam.length > 0
  ? dataTanam.map((d: any) => ({
      id: d.id,
      komoditas: d.komoditas,
      luas: `${d.luas_lahan || 0} Ha`,
      lokasiDetail: d.lokasi || "Indonesia",
      prediksiPanen: d.estimasi_panen
        ? new Date(d.estimasi_panen).toLocaleDateString("id-ID")
        : "-",
      estimasiHasil: d.volume_estimasi
        ? `${(d.volume_estimasi / 1000).toFixed(1)} Ton`
        : "-",
      // ... field lainnya sesuai kebutuhan UI
    }))
  : lahanAktif; // mock data sebagai fallback
```

### 3.2 Kirim Pesan dengan Konteks Panen

```typescript
const sendMessage = async () => {
  if (!chatInput.trim() || chatLoading) return;
  const msg = chatInput.trim();
  setChatInput("");
  setChatMessages(prev => [...prev, { role: "user", text: msg }]);
  setChatLoading(true);

  try {
    // Siapkan history untuk multi-turn conversation
    const history = chatMessages.map(m => ({
      role: m.role === "user" ? "user" as const : "model" as const,
      text: m.text,
    }));

    // Susun konteks data panen (real atau mock)
    const panenContext = (dataTanam.length > 0 ? dataTanam : lahanAktif)
      .map((d: any) => ({
        komoditas: d.komoditas,
        luas_lahan: d.luas_lahan || parseFloat(d.luas),
        tanggal_tanam: d.tanggal_tanam || d.tanggalTanam,
        estimasi_panen: d.estimasi_panen || d.prediksiPanen,
        volume_estimasi: d.volume_estimasi,
        lokasi: d.lokasi || d.lokasiDetail,
        status: d.status || d.fase,
      }));

    const reply = await sendToGemini(msg, history, panenContext);
    setChatMessages(prev => [...prev, { role: "ai", text: reply }]);
  } catch (err: any) {
    setChatMessages(prev => [...prev, {
      role: "ai",
      text: `⚠️ ${err.message || "Tidak dapat terhubung ke AI."}`,
    }]);
  } finally {
    setChatLoading(false);
  }
};
```

